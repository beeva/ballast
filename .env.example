# --- Database ---------------------------------------------------------
DATABASE_URL=postgres://ballast:ballast@localhost:5432/ballast

# --- Auth (admin dashboard) ---------------------------------------------
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# --- Build runner -----------------------------------------------------
# Where the worker checks out a service's repo and runs its build command.
# Safe to leave as the default for local dev - gitignored, created on demand.
BALLAST_WORKSPACE_DIR=./.ballast/workspaces

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
